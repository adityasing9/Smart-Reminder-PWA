<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp">

    <!-- Top Label -->
    <TextView
        android:id="@+id/tvAlarmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="⏰ SMART REMINDER ALARM"
        android:textColor="#34D399"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Current Time -->
    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAlarmLabel"
        tools:text="05:30 PM" />

    <!-- Pulsing Bell Icon -->
    <ImageView
        android:id="@+id/ivAlarmBell"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_stat_notification"
        app:tint="#10B981"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentTime" />

    <!-- Card with Title & Description -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardReminderDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivAlarmBell">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvAlarmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Team Strategy Meeting" />

            <TextView
                android:id="@+id/tvAlarmDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                tools:text="Prepare the roadmap slides and check metrics dashboard before the call starts." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="DISMISS ALARM"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:backgroundTint="#10B981" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnooze"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Snooze (+10 Minutes)"
            android:textColor="#94A3B8"
            android:textSize="15sp"
            app:cornerRadius="18dp"
            app:strokeColor="#475569" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
